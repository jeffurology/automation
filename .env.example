# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
# Credentials are referenced by name in the code (process.env.EVICORE_PW) and
# never stored in packets or recordings.

# Data root for all PHI-adjacent runtime data (outside the repo).
PA_ROOT=/opt/pa

# EviCore portal credentials
EVICORE_USER=
EVICORE_PW=

# Add one pair per portal as you onboard them, e.g.:
# COHERE_USER=
# COHERE_PW=
